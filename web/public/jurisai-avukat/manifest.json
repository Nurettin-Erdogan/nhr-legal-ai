{
  "manifest_version": 3,
  "name": "NHR Hukuk - UYAP Avukat Portalı Aktarımı",
  "version": "2.8.0",
  "description": "UYAP Avukat Portalı'ndaki evrakları tek tıkla NHR Hukuk hesabınıza aktarır (UDF/PDF destekli). Otomatik aktarım varsayılan olarak kapalıdır.",
  "permissions": ["activeTab", "scripting", "downloads", "storage"],
  "host_permissions": [
    "*://*.adalet.gov.tr/*",
    "*://*.uyap.gov.tr/*",
    "http://localhost:8766/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NHR Hukuk - UYAP Aktarımı",
    "default_icon": {
      "16": "images/icon-16.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  },
  "icons": {
    "16": "images/icon-16.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.adalet.gov.tr/*", "*://*.uyap.gov.tr/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
