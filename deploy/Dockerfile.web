# Web (TanStack Start, Node sunucu hedefi). Bağlam: web/.  docker build -f deploy/Dockerfile.web -t nhr-web web
FROM node:22-alpine AS build
WORKDIR /web
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# Varsayılan Nitro hedefi Cloudflare'dir; kendi sunucumuz için node-server. VITE_API_URL boş: tarayıcı /api isteklerini
# aynı adrese gönderir, ters vekil (Caddy) bunları API'ye iletir (tek köken, çerez sorunu yok).
ENV NITRO_PRESET=node-server VITE_API_URL=
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000
COPY --from=build /web/.output ./.output
RUN addgroup -S app && adduser -S app -G app
USER app
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD wget -qO- http://127.0.0.1:3000/ >/dev/null || exit 1
CMD ["node", ".output/server/index.mjs"]
