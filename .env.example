# PostgreSQL
POSTGRES_DB=nhr_legal_ai
POSTGRES_USER=nhr_app
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5433

# Uygulama bağlantısı (RLS uygulanan, tablo sahibi olmayan rol)
NHR_RUNTIME_DB_USER=nhr_runtime
NHR_RUNTIME_DB_PASSWORD=change_me_runtime_local_only
DATABASE_URL=postgresql://nhr_runtime:change_me_runtime_local_only@localhost:5433/nhr_legal_ai

# Yalnız migration ve yerel veritabanı yönetimi
DATABASE_ADMIN_URL=postgresql://nhr_app:change_me_local_only@localhost:5433/nhr_legal_ai

# Web/API
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8765

# Kimlik doğrulama (en az 32 karakterlik rastgele bir değer kullanın)
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
AUTH_COOKIE_SECURE=false
ALLOW_REGISTRATION=true

# AI servisleri (gerçek anahtarları .env dosyasına yazın)
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
RAG_TOP_K=6
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
EMBEDDING_API_KEY=
