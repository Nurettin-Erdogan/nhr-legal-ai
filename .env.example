# PostgreSQL
POSTGRES_DB=nhr_legal_ai
POSTGRES_USER=nhr_app
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5433

# Uygulama bağlantısı (RLS uygulanan, tablo sahibi olmayan rol)
NHR_RUNTIME_DB_USER=nhr_runtime
NHR_RUNTIME_DB_PASSWORD=change_me_runtime_local_only
DATABASE_URL=postgresql://nhr_runtime:change_me_runtime_local_only@localhost:5433/nhr_legal_ai

# Yalnız migration ve yerel veritabanı yönetimi
DATABASE_ADMIN_URL=postgresql://nhr_app:change_me_local_only@localhost:5433/nhr_legal_ai

# Web/API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8765
DOCUMENT_STORAGE_DIR=uploads
MAX_DOCUMENT_SIZE_MB=10

# Kimlik doğrulama (en az 32 karakterlik rastgele bir değer kullanın)
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
AUTH_COOKIE_SECURE=false
ALLOW_REGISTRATION=true

# Google OAuth (Web application client; secret yalnızca API .env dosyasında kalır)
# Google Cloud Authorized redirect URI bu değerle karakter karakter aynı olmalı.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8766/api/auth/google/callback
GOOGLE_WEB_CALLBACK_URL=http://localhost:3000/auth/callback

# Yerel AI (Ollama). 6GB GPU'da sohbet için 3B; 8B R1 kartı taşır ve dakikalar sürer.
AI_PROVIDER=qwen
AI_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_MAX_OUTPUT_TOKENS=768
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=30m
RAG_TOP_K=6
RAG_CONTEXT_CHARS=2400
RAG_QUERY_EMBEDDING=true
RAG_EXPLANATIONS=true
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# Ingestion worker (kısa soğuma; 429 artarsa delay'i yükseltin)
YARGITAY_SYNC_INTERVAL_MINUTES=2
DANISTAY_SYNC_INTERVAL_MINUTES=2
MEVZUAT_SYNC_INTERVAL_MINUTES=2
KDK_SYNC_INTERVAL_MINUTES=2
AYM_SYNC_INTERVAL_MINUTES=2
YARGITAY_BACKFILL_INTERVAL_MINUTES=1
DANISTAY_BACKFILL_INTERVAL_MINUTES=1
MEVZUAT_BACKFILL_INTERVAL_MINUTES=1
KDK_BACKFILL_INTERVAL_MINUTES=1
AYM_BACKFILL_INTERVAL_MINUTES=1
INGESTION_FAILURE_RETRY_MINUTES=0.25
INGESTION_CAPTCHA_RETRY_MINUTES=0.5
INGESTION_RATE_LIMIT_RETRY_MINUTES=2
WORKER_POLL_SECONDS=5
YARGITAY_DELAY_SECONDS=0.25
DANISTAY_DELAY_SECONDS=0.35
MEVZUAT_DELAY_SECONDS=0.2
KDK_DELAY_SECONDS=0.25
AYM_DELAY_SECONDS=0.25
AYM_PAGE_SIZE=100
KDK_PAGE_SIZE=100
MEVZUAT_DISCOVERY_PAGE_SIZE=20
MEVZUAT_VERIFY_INLINE=true
YARGITAY_MAX_RECORDS_PER_RUN=80
DANISTAY_MAX_RECORDS_PER_RUN=50
MEVZUAT_MAX_ARTICLES_PER_RUN=50
KDK_MAX_RECORDS_PER_RUN=40
AYM_MAX_RECORDS_PER_RUN=40
YARGITAY_CORPUS_START=2000-01-01
DANISTAY_CORPUS_START=1982-01-01
KDK_CORPUS_START=2017-01-01
# Güncel şerit: Yargıtay/Danıştay/KDK son N günün takvim aylarını yeniden tarar.
CURRENT_LOOKBACK_DAYS=45
CURRENT_SYNC_INTERVAL_MINUTES=2
CURRENT_RETRY_INTERVAL_MINUTES=1
FULL_CORPUS_START=2000-01-01
BACKFILL_PAUSE_SECONDS=0.3
DANISTAY_BACKFILL_PAUSE_SECONDS=3
MEVZUAT_DISCOVERY_TYPES=KANUN,KHK,CB_KARARNAME,TUZUK,YONETMELIK,CB_YONETMELIK,TEBLIGLER,CB_KARAR,CB_GENELGE
EMBED_AFTER_SYNC=true
EMBED_LIMIT_PER_RUN=200
EMBED_BATCH_SIZE=10
INGESTION_SNAPSHOT_DIR=data/raw
INGESTION_MAX_RETRIES=3

# OCR (taranmış belgeler): docs/ocr.md
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSDATA_PREFIX=data/tessdata
# OCR_MAX_PAGES=40
# OCR_RENDER_SCALE=3.0
# OCR_PAGE_TIMEOUT=120

# Dava belgesi çöp kutusu: kaç gün sonra kalıcı silinir (docs/office-document-trash.md)
# OFFICE_TRASH_RETENTION_DAYS=30
