# PostgreSQL
POSTGRES_DB=nhr_legal_ai
POSTGRES_USER=nhr_app
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5433

# Uygulama bağlantısı (RLS uygulanan, tablo sahibi olmayan rol)
NHR_RUNTIME_DB_USER=nhr_runtime
NHR_RUNTIME_DB_PASSWORD=change_me_runtime_local_only
DATABASE_URL=postgresql://nhr_runtime:change_me_runtime_local_only@localhost:5433/nhr_legal_ai

# Yalnız migration ve yerel veritabanı yönetimi
DATABASE_ADMIN_URL=postgresql://nhr_app:change_me_local_only@localhost:5433/nhr_legal_ai

# Web/API
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8765
DOCUMENT_STORAGE_DIR=uploads
MAX_DOCUMENT_SIZE_MB=10

# Kimlik doğrulama (en az 32 karakterlik rastgele bir değer kullanın)
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
AUTH_COOKIE_SECURE=false
ALLOW_REGISTRATION=true

# Yerel AI (Ollama + DeepSeek). Embedding ayrı Ollama modelidir; DeepSeek sohbet API'sinde embedding yoktur.
AI_PROVIDER=deepseek
AI_MODEL=deepseek-r1:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_OUTPUT_TOKENS=384
OLLAMA_NUM_CTX=1536
OLLAMA_KEEP_ALIVE=30m
RAG_TOP_K=2
RAG_CONTEXT_CHARS=800
RAG_QUERY_EMBEDDING=false
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# Ingestion worker (agresif default yok; resmi portalları yormayın)
YARGITAY_SYNC_INTERVAL_MINUTES=360
DANISTAY_SYNC_INTERVAL_MINUTES=720
MEVZUAT_SYNC_INTERVAL_MINUTES=720
KDK_SYNC_INTERVAL_MINUTES=1440
AYM_SYNC_INTERVAL_MINUTES=1440
# Tamamlanmamış arşiv taraması için; hata/CAPTCHA halinde normal aralık kullanılır.
YARGITAY_BACKFILL_INTERVAL_MINUTES=60
DANISTAY_BACKFILL_INTERVAL_MINUTES=90
MEVZUAT_BACKFILL_INTERVAL_MINUTES=120
KDK_BACKFILL_INTERVAL_MINUTES=180
AYM_BACKFILL_INTERVAL_MINUTES=180
WORKER_POLL_SECONDS=30
YARGITAY_DELAY_SECONDS=1.5
DANISTAY_DELAY_SECONDS=2.0
MEVZUAT_DELAY_SECONDS=1.0
KDK_DELAY_SECONDS=2.0
AYM_DELAY_SECONDS=2.0
YARGITAY_MAX_RECORDS_PER_RUN=40
DANISTAY_MAX_RECORDS_PER_RUN=30
MEVZUAT_MAX_ARTICLES_PER_RUN=30
KDK_MAX_RECORDS_PER_RUN=20
AYM_MAX_RECORDS_PER_RUN=20
YARGITAY_CORPUS_START=2020-01-01
DANISTAY_CORPUS_START=2020-01-01
KDK_CORPUS_START=2020-01-01
INGESTION_SNAPSHOT_DIR=data/raw
INGESTION_MAX_RETRIES=3
